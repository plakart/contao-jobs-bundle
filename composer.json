{
  "name": "plakart/contao-jobs-bundle",
  "type": "contao-bundle",
  "description": "Stellenangebote pflegen + export nach GoogleForJobs",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Agentur plakart",
      "email": "technik@plakart.de",
      "homepage": "https://plakart.de",
      "role": "Publisher"
    },
    {
      "name": "Jannik Nölke",
      "email": "jannik.noelke@plakart.de",
      "homepage": "https://plakart.de",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.3 || ^6.0",
    "google/apiclient": "^2.19"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0"
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
  },
  "extra": {
    "contao-manager-plugin": "Plakart\\ContaoJobsBundle\\ContaoManager\\Plugin",
    "google/apiclient-services": [
      "Indexing"
    ]
  },
  "autoload": {
    "psr-4": {
      "Plakart\\ContaoJobsBundle\\": "src/"
    }
  }
}