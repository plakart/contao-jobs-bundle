{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{% block content %}
    <div class="job_element{% if form %} with--form{% endif %} {{ cssClass }}">
        {% block textElements %}
            <div class="job_details">
                <div class="job_texts">
                    {% block jobHeadline %}
                        <h1>{{ title }}</h1>
                    {% endblock %}
                    {% block jobSubheadline %}
                        {% if subheadline %}
                            <h2 class="subheadline">{{ subheadline }}</h2>
                        {% endif %}
                    {% endblock %}
                    {% block jobTeaser %}
                        {% if teaser %}
                            <div class="content-text teaser">
                                {{ teaser|raw }}
                            </div>
                        {% endif %}
                    {% endblock %}
                    {% block jobText %}
                        {{ text|raw }}
                    {% endblock %}
                    {% block jobLocations %}
                        {% if locations %}
                            <div class="job_locations">
                                <h2>{{ 'MSC.plakart_jobs.locations'|trans({}, 'contao_default') }}</h2>
                                <ul>
                                    {% for location in locations %}
                                        <li>
                                            <strong>{{ location.title }}</strong>
                                            <address>
                                                {% if location.street %}{{ location.street }} {{ location.streetNr }}<br>{% endif %}
                                                {{ location.zip }} {{ location.city }}
                                            </address>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endblock %}
                    {% block jobContacts %}
                        {% if contacts %}
                            <div class="job_contacts">
                                <h2>{{ 'MSC.plakart_jobs.contacts'|trans({}, 'contao_default') }}</h2>
                                {% for contact in contacts %}
                                    <div class="job_contact">
                                        {% if contact.figure %}
                                            {% with {figure: contact.figure} %}{{ block('figure_component') }}{% endwith %}
                                        {% endif %}
                                        <p>
                                            <strong class="name">{{ contact.name }}</strong>
                                            {% if contact.position %}<br><span class="position">{{ contact.position }}</span>{% endif %}
                                            {% if contact.phone %}<br><a class="phone" href="tel:{{ contact.phone|replace({' ': '', '/': '', '-': '', '(': '', ')': ''}) }}">{{ contact.phone }}</a>{% endif %}
                                            {% if contact.email %}<br><a class="email" href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
                                        </p>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
                {% block jobImage %}
                    {% if figure %}
                    <div class="job_image">
                        {% with {figure: figure} %}{{ block('figure_component') }}{% endwith %}
                    </div>
                    {% endif %}
                {% endblock %}
            </div>
        {% endblock %}
        {% block formElement %}
            {% if form %}
                <div class="job_form">
                    {{ form|raw }}
                </div>
            {% endif %}
        {% endblock %}
    </div>
    {% block goBack %}
        <div class="goBack">
            <a href="{{ goBack }}">{{ 'MSC.goBack'|trans({}, 'contao_default') }}</a>
        </div>
    {% endblock %}

    {% block googleForJobsSchema %}
        {% if addGfjSchema %}
            <script type="application/ld+json">
              {{ gfj|raw }}
            </script>
        {% endif %}
    {% endblock %}
{% endblock %}
